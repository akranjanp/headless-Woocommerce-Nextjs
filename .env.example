# Zelevation Commerce - WooCommerce Headless Environment
# Set to 'false' when connecting to live WordPress/WooCommerce site
NEXT_PUBLIC_USE_MOCK_DATA=true

# WordPress & WooGraphQL Endpoint
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-site.com/graphql

# WooCommerce REST API (Optional for server-side operations)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3001
